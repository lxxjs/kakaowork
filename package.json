{
  "name": "kakaowork",
  "version": "0.1.0",
  "description": "KakaoTalk for macOS, in your terminal — with a Claude Code–style UI",
  "type": "module",
  "bin": {
    "kakaowork": "bin/kakaowork.js"
  },
  "scripts": {
    "build:bridge": "mkdir -p dist && swiftc -O -framework ApplicationServices -framework AppKit bridge/*.swift -o dist/kakao-bridge",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:bridge && npm run build:ts",
    "start": "node bin/kakaowork.js",
    "demo": "node bin/kakaowork.js --demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin",
    "dist",
    "bridge",
    "src"
  ]
}
