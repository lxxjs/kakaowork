{
  "name": "@lxxjs/kakaowork",
  "version": "0.1.0",
  "description": "KakaoTalk for macOS, in your terminal — with a Claude Code–style UI",
  "type": "module",
  "bin": {
    "kakaowork": "bin/kakaowork.js"
  },
  "scripts": {
    "build:bridge": "sh scripts/build-bridge.sh",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run clean && npm run build:bridge && npm run build:ts",
    "start": "node bin/kakaowork.js",
    "demo": "node bin/kakaowork.js --demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxxjs/kakaowork.git"
  },
  "homepage": "https://github.com/lxxjs/kakaowork#readme",
  "keywords": [
    "kakaotalk",
    "kakao",
    "cli",
    "tui",
    "macos",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  }
}
